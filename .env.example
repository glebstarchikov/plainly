# Every env var the code reads. Copy to .env.local for local development.
# In production, set them in the host's settings (on Vercel: Project Settings, Environment Variables).

# The one canonical address of the app, used for sign-in callbacks and links in emails.
# Required when NODE_ENV=production (`npm run build`, `npm start`). On Vercel it falls back to the
# production domain; in development it defaults to http://localhost:3000.
BASE_URL="http://localhost:3000"
# Fallback for BASE_URL, read only by `npm run setup:github-app`.
# BETTER_AUTH_URL="http://localhost:3000"

# Signs sessions. Any long random string, for example from `openssl rand -base64 32`.
BETTER_AUTH_SECRET="random-string-of-characters"
# Alias for BETTER_AUTH_SECRET; wins when both are set.
# AUTH_SECRET="random-string-of-characters"
# Encrypts the GitHub App installation tokens cached in the database (AES-256). Must be base64 of
# exactly 32 bytes: generate it with `openssl rand -base64 32`.
CRYPTO_KEY="base64-of-32-random-bytes"

# Comma-separated emails that can open /admin. Optional; empty means nobody.
# ADMIN_EMAILS="admin@example.com,other-admin@example.com"

# The GitHub App that reads and commits site content. `npm run setup:github-app -- --env .env.local`
# creates one and writes all six values. Its client ID and secret also power "Sign in with GitHub".
# By hand: GitHub, Settings, Developer settings, GitHub Apps.
GITHUB_APP_ID="your-github-app-id"
# The app's slug (the name in its github.com/apps/<slug> URL), used for the install link.
GITHUB_APP_NAME="your-github-app-machine-name"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
xxx
-----END RSA PRIVATE KEY-----"
# Verifies deliveries to /api/webhook/github. GitHub returns it when the setup script creates the app.
GITHUB_APP_WEBHOOK_SECRET="another-random-string-of-characters"
GITHUB_APP_CLIENT_ID="your-github-app-client-id"
GITHUB_APP_CLIENT_SECRET="your-github-app-client-secret"

# Email: sign-in codes and collaborator invitations. Without RESEND_API_KEY or SMTP_HOST,
# sending a sign-in code fails with "No email provider configured".
# Optional. Default: "resend" when RESEND_API_KEY is set, otherwise "smtp" when SMTP_HOST is set.
# EMAIL_PROVIDER="resend" # or "smtp"
# Sender of every email. Required to send any.
EMAIL_FROM="Plainly <no-reply@example.com>"
# Older alias for EMAIL_FROM.
# RESEND_FROM_EMAIL="Plainly <no-reply@example.com>"
# Resend: an API key from resend.com. The EMAIL_FROM domain must be verified there.
# RESEND_API_KEY="your-resend-api-key"
# SMTP: any SMTP server. SMTP_PORT defaults to 587, and SMTP_SECURE defaults to true only on port 465.
# Set SMTP_USER and SMTP_PASSWORD together, or neither.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="smtp-user"
# SMTP_PASSWORD="smtp-password"

# The app's database. In production this is Supabase's transaction pooler (port 6543).
DATABASE_URL="postgresql://plainly:plainly@127.0.0.1:5432/plainly"
# Used by `npm run db:migrate` instead of DATABASE_URL. In production it must be a session-mode
# connection (Supabase's session pooler or direct URL): the transaction pooler can't run migrations.
# Optional; defaults to DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://user:password@host:5432/postgres"
# Maximum database connections per server instance. Default 5.
# POSTGRES_MAX_CONNECTIONS=5

# Cache tuning, all optional.
# Minutes between checks of the file cache against GitHub. Default 5.
# CACHE_CHECK_MIN=5
# Minutes between checks of a repository's .pages.yml. Default 5. Older names: CFG_CHECK_MIN, CONFIG_CHECK_TTL.
# CONFIG_CHECK_MIN=5
# Minutes a cached file lives; -1 keeps files forever. Default 1440.
# FILE_TTL_MIN=1440
# Minutes a user's access to a repository stays cached. Default 60. Older names: PERM_TTL_MIN, PERMISSION_CACHE_TTL.
# PERMISSIONS_TTL_MIN=60
# Milliseconds a branch's head commit and a repository's metadata stay cached. Default 15000 each.
# BRANCH_HEAD_TTL_MS=15000
# REPO_META_TTL_MS=15000
# Milliseconds after which an unfinished cache sync may be started again. Default 15000.
# CACHE_META_SYNC_STALE_MS=15000
# Webhook push processing thresholds
# <= WEBHOOK_PUSH_INCREMENTAL_MAX_FILES: incremental cache updates
# > WEBHOOK_PUSH_INCREMENTAL_MAX_FILES and <= WEBHOOK_PUSH_SCOPED_INVALIDATION_MAX_FILES: scoped cache invalidation
# > WEBHOOK_PUSH_SCOPED_INVALIDATION_MAX_FILES: full branch cache invalidation
# WEBHOOK_PUSH_INCREMENTAL_MAX_FILES=120
# WEBHOOK_PUSH_SCOPED_INVALIDATION_MAX_FILES=800

# Seconds a collaborator invite link stays valid. Default 86400 (one day).
# COLLABORATOR_INVITE_LINK_EXPIRES_IN=86400
# Version shown in the About dialog. Default: the deployed Git tag on Vercel (vX.Y.Z), else package.json's version.
# NEXT_PUBLIC_APP_VERSION="2.1.8"
# Read only by db/scripts/export-collaborators-legacy-libsql.mjs, as an alternative to its --url and --token flags.
# SQLITE_URL="libsql://your-database.turso.io"
# SQLITE_AUTH_TOKEN="your-libsql-token"

# Set by the platform, listed for reference; don't set them yourself.
# NODE_ENV: set by Next.js.
# VERCEL_ENV: `postbuild` applies migrations only when it is "production".
# VERCEL_PROJECT_PRODUCTION_URL: the fallback for BASE_URL.
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_REF: the deployed Git ref, which the About dialog reads its version from.
